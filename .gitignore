# =============== #
# Unity GitIgnore #
# =============== #

# Never git trigger these folders because they are regenerated by Unity
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Build]/
/[Builds]/
/[Logs]/
/[UserSettings]/
/[MemoryCaptures]/

# Asset store packages can be downloaded again
/[As]sets/AssetStoreTools*

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userbreak
*.cache
*.pdb
*.opendb
*.VC.db

# Unity results and log files
*.pidb.meta
*.pidb
*.log
*.crash

# Crashlytics generated file
crashlytics-build.properties

# OS autogenerated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db